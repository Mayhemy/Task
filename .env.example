# Copy to .env and fill in. .env is gitignored.
# Generate the bearer token with:  openssl rand -hex 32

APP_BEARER_TOKEN=

# OpenAI-compatible LLM provider. Leave blank to disable the llm provider
# (jobs using provider:"llm" then fail gracefully with "llm provider not configured").
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
